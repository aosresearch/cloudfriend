# SHA-256 of the round-4 derived inputs, too large for git (about 3 GB), paths relative to the data dir.
# They are deterministic from the raw files in raw.sha256 with this commit's code:
#   python3 ml/datasets/re3.py --raw rcaeval --out prepared/re3-v3
#   unzip -p gaia/business_cat.zip business/business_table_2021-08.csv | \
#     python3 ml/datasets/gaia.py --run gaia/run/run_table_2021-08.csv --start 2021-08-01 --days 21 --out prepared/gaia21
#     (labels were written by: python3 ml/datasets/gaia.py --relabel --run gaia/run/run_table_2021-08.csv --start 2021-08-01 --days 21 --jobs 4 --out prepared/gaia21)
#   tail -n +2 evidence/evidence.csv | cut -d, -f1 > evidence/ids.txt      # from evidence.tar.gz
#   node ml/featurize.ts --data prepared/re3-v3 --featurizer-version 3 --force evidence/ids.txt --out features-v3/re3 --keep 0.05
#   node ml/featurize.ts --data prepared/gaia21:0.005:0.1 --featurizer-version 3 --force evidence/ids.txt --out features-v3/gaia --keep 0.05
#   ml/combine.py for features-v3/A and features-v3/B: see models.tar.gz models/models.json
# Holdout days (gaia-2021-08-15 .. 21) are in prepared/gaia21 but no model has been run on them.
