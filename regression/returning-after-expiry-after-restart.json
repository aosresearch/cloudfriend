      "level": "error",
      "message": "edu.fudan.common.exception.TokenException: Token is not proper, user {i}"
     },
     "must_reach": true
    }
   ]
  },
  {
   "at": "11521m",
   "every": "5s",
   "events": [
    {
     "data": {
      "service": "ts-travel2-service",
      "level": "error",
      "message": "edu.fudan.common.exception.TokenException: Token is not proper, user {i}"
     },
     "repeat": 5,
     "must_reach": true
    }
   ]
  }
 ]
