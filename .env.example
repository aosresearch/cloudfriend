# Settings for `docker compose up`. Copy this file to .env and edit it:
#
#   cp .env.example .env
#
# Only POSTGRES_PASSWORD is required. Lines starting with # are off. Every variable is described
# in the README's Configuration section. Keep .env out of version control: it holds secrets.

# --- Required ------------------------------------------------------------------------------

# Password of the bundled Postgres, e.g. the output of `openssl rand -hex 24`. It is set when the
# database volume is first created; changing it here later also needs
# `docker compose exec postgres psql -U cloudfriend -c "ALTER USER cloudfriend PASSWORD '...'"`.
# Avoid $ (Compose would read it as a variable).
POSTGRES_PASSWORD=

# --- Jev, the decider ----------------------------------------------------------------------

# OpenRouter key (openrouter.ai/keys). Without one, the classifier decides alone.
# OPENROUTER_API_KEY works too.
# JEV_API_KEY=sk-or-...

# Spend cap per workspace per UTC day. Once reached, the classifier decides alone until the
# day ends.
# CLOUDFRIEND_JEV_DAILY_BUDGET_USD=5

# --- Dashboard and sign-in -----------------------------------------------------------------

# The address people and senders use. Source endpoints, the OIDC redirect URI and Secure
# cookies follow it. Put cloudfriend behind TLS and set this to the https address.
# CLOUDFRIEND_PUBLIC_URL=https://cloudfriend.example.com

# The first admin. Set both and that account is kept in sync with them at every boot (the
# password needs 12 characters or more). Leave both unset and the first boot creates
# admin@localhost and prints its password once: `docker compose logs cloudfriend`.
# CLOUDFRIEND_ADMIN_EMAIL=you@example.com
# CLOUDFRIEND_ADMIN_PASSWORD=

# Single sign-on (OIDC): set the issuer, client id and secret, and CLOUDFRIEND_PUBLIC_URL.
# Register <CLOUDFRIEND_PUBLIC_URL>/auth/oidc/callback as the redirect URI with the provider.
# CLOUDFRIEND_OIDC_ISSUER=https://example.auth0.com/
# CLOUDFRIEND_OIDC_CLIENT_ID=
# CLOUDFRIEND_OIDC_CLIENT_SECRET=
# CLOUDFRIEND_OIDC_ALLOWED_DOMAINS=example.com

# --- Where flags go ------------------------------------------------------------------------

# Destinations are normally added in the dashboard. Each of these becomes a destination of the
# default workspace on first boot, if it has none yet.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_URL=https://example.com/cloudfriend-hook
# WEBHOOK_SECRET=

# Lets destinations use http and private or loopback addresses, e.g. a webhook on your own
# network. Security: with this on, anyone who can sign in (and so create a workspace) can make
# the server send requests to any host it can reach, such as internal services or a cloud
# metadata endpoint. Leave it off unless everyone who can sign in is trusted.
# CLOUDFRIEND_ALLOW_PRIVATE_DESTINATIONS=on

# --- Admin API ------------------------------------------------------------------------------

# Turns on the admin API (/secrets, /flags, /events) for scripts. Pick a long random value.
# The CLI (`docker compose exec cloudfriend cloudfriend ...`) works without it.
# CLOUDFRIEND_ADMIN_KEY=

# --- Compose --------------------------------------------------------------------------------

# Host port, or address:port. Use 127.0.0.1:8080 when a reverse proxy on the same host
# terminates TLS, so the plain HTTP port is not reachable from outside.
# CLOUDFRIEND_PORT=8080

# Tag of ghcr.io/aosresearch/cloudfriend that `docker compose pull` fetches.
# CLOUDFRIEND_VERSION=latest

# Separate web and worker processes: the cloudfriend service serves HTTP and intake, and the
# worker service processes events. Add workers with `docker compose up -d --scale worker=2`.
# CLOUDFRIEND_ROLE=web
# COMPOSE_PROFILES=split
